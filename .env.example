# Copy this file to .env and fill in real values for local development.
# On Render, set these as Environment Variables in the service dashboard instead
# (or use a single DATABASE_URL if you provision a Render PostgreSQL instance —
# db.py automatically prefers DATABASE_URL when it is present).

DB_HOST=localhost
DB_PORT=5432
DB_NAME=gradenix
DB_USER=postgres
DB_PASSWORD=your_password

# Flask session secret (optional — falls back to a dev default if unset)
GRADENIX_SECRET=change-me-in-production
